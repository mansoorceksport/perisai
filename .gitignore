node_modules/
.next/
coverage/
.DS_Store
*.log
.env*
!.env.example
.claude
.playwright-mcp
CLAUDE.MD
# TypeScript incremental build cache — machine-specific, regenerated on build
tsconfig.tsbuildinfo

# Stale snapshot archive of the source tree; the working tree is authoritative
claude_code_updates.zip

# Firebase browser config — supplied via NEXT_PUBLIC_* env vars instead
firebase-applet-config.json

# Bun lockfiles are kept local only. Cloud Run buildpacks run a newer Bun than
# local, and `bun install --frozen-lockfile` rejects a lockfile written by an
# older Bun, failing the build. package-lock.json drives the production install
# instead; its resolved versions match the local Bun install exactly.
bun.lock
bun.lockb
