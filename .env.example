# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase browser configuration.
#
# These are identifiers, not credentials: Next inlines every NEXT_PUBLIC_* value
# into the JavaScript served to the browser, because the Firebase Web SDK needs
# them to reach Identity Toolkit before any user is signed in. They are kept out
# of the repository so the tree carries no key-shaped strings, but they are
# readable in any deployed build by design.
#
# What actually protects the project:
#   - firestore.rules            owner-bound; the key reads nobody's data
#   - Auth authorized domains    only listed origins can complete a sign-in
#   - API key referrer limits    restrict the key to those same origins
#
# Copy them from Firebase Console > Project settings > Your apps > SDK setup.
# All seven must be set at BUILD time (--set-build-env-vars), or the browser
# receives undefined and the app renders permanently signed out.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Named Firestore database; leave empty to use (default).
NEXT_PUBLIC_FIREBASE_DATABASE_ID=""


# ALLOW_DEMO_AUTH: LOCAL DEVELOPMENT ONLY. Leave unset.
# When set to exactly "true" AND NODE_ENV is "development", the server accepts
# `Authorization: Bearer demo-preview-token:<uid>` as proof of identity WITHOUT
# verifying any signature. Anyone who can reach the server can then act as any
# uid. It exists so the API routes can be exercised without a Google sign-in.
# It is ignored under a production build, so setting it there does nothing.
# Every use logs a [SECURITY] warning.
ALLOW_DEMO_AUTH=""
